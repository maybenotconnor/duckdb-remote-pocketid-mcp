# Copy to .env and fill in.

# Public URL of this server through your reverse proxy. No trailing slash.
MCP_BASE_URL=https://duckdb-mcp.example.com

# PocketID OIDC client (README step 2). The issuer is your PocketID URL.
POCKETID_ISSUER_URL=https://id.example.com
POCKETID_CLIENT_ID=

# Host folder to query. Mounted read-only at DATA_DIR in the container.
DATA_PATH=/srv/data
DATA_DIR=/data

# Address and port the reverse proxy reaches. 127.0.0.1 when it runs on this host.
BIND_ADDR=127.0.0.1
HOST_PORT=8766
# Port inside the container.
PORT=8000

# Result and resource limits.
MAX_ROWS=1000
MAX_CHARS=50000
QUERY_TIMEOUT=30
# DuckDB memory cap, e.g. 1GB. Empty = DuckDB default (80% of the container's memory).
DUCKDB_MEMORY_LIMIT=
MEM_LIMIT=2g

LOG_LEVEL=INFO
